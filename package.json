{
  "name": "distributed-task-queue",
  "version": "1.1.0",
  "description": "High-throughput asynchronous distributed task queue with priority scheduling, worker pool concurrency, and DLQ observability metrics",
  "keywords": [
    "task-queue",
    "job-queue",
    "worker-pool",
    "priority-queue",
    "dead-letter-queue",
    "retry",
    "backoff",
    "typescript"
  ],
  "homepage": "https://github.com/imaqib101/distributed-task-queue#readme",
  "bugs": {
    "url": "https://github.com/imaqib101/distributed-task-queue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imaqib101/distributed-task-queue.git"
  },
  "license": "MIT",
  "author": "Mohammed Aqib",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.10.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^1.1.0"
  }
}
